# Copy to .env only if you do not already have one. Never commit credentials.
PORT=5000
PYTHON_PATH=python

# The demo always archives reports locally; PostgreSQL mirroring is optional.
OSIS_PERSIST_POSTGRES=false
# OSIS_REPORT_DIR=C:/path/to/osis-reports
# DATABASE_URL=postgresql://osis:CHANGE_ME@localhost:5432/osis

# Opt-in rollback-only database integration test (requires configured PostGIS DB).
OSIS_TEST_DATABASE=false

# Real satellite/environment research adapters have separate provider credentials.
# See docs/ARCHITECTURE.md. They are not needed by /api/incidents/analyze.